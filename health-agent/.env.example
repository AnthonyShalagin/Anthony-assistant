# Hermes Health Agent — Environment Variables
# Copy to .env and fill in your values.

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Oura Ring — bearer token from https://cloud.ouraring.com/personal-access-tokens
OURA_TOKEN=your-oura-personal-access-token

# Whoop — OAuth2 credentials from https://developer.whoop.com
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_REDIRECT_URI=https://localhost/callback

# Garmin — OAuth 1.0a credentials from https://developer.garmin.com
GARMIN_CONSUMER_KEY=your-garmin-consumer-key
GARMIN_CONSUMER_SECRET=your-garmin-consumer-secret

# LLM via OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=anthropic/claude-sonnet-4-6

# Database (optional — defaults to health-agent/data/health.db)
# DB_PATH=/path/to/health.db
